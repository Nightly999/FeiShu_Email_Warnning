APP_ENV=dev
APP_DATABASE_PATH=./data/agent.db
SQLITE_BUSY_TIMEOUT_MS=10000
SCHEDULER_POLL_SECONDS=15
SCHEDULER_TASK_TIMEOUT_SECONDS=120
SCHEDULER_MAX_RETRIES=5
SCHEDULER_CONCURRENCY=4
SCHEDULER_LIST_PAGE_SIZE=5
SCHEDULER_HISTORY_PAGE_SIZE=5
BUSINESS_LIST_PAGE_SIZE=20
BUSINESS_LIST_MAX_COLUMNS=20

# 模型配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=qwen3.7-plus
AGENT_RECURSION_LIMIT=12

# MCP HTTP端点
MCP_BASE_URL=http://127.0.0.1:8765/mcp/
MCP_TIMEOUT_SECONDS=60
MCP_SERVER_NAME=erp-sqlserver
TOOLS_CONFIG_PATH=./config/tools.local.json

# 飞书 API
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APPS_CONFIG_PATH=./config/feishu_apps.local.json
FEISHU_SIGNATURE_MAX_AGE_SECONDS=300
FEISHU_EVENT_WORKERS=8
FEISHU_EVENT_QUEUE_SIZE=64
MAX_FILE_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=20971520
PERMISSION_FAIL_CLOSED=true

# Reply behavior
FEISHU_REPLY_ENABLED=true

# 邮件分析
EMAIL_FEATURE_ENABLED=true
EMAIL_BIND_TOKEN_TTL_SECONDS=600
EMAIL_POP3_HOST=mail.asiansha.com
EMAIL_POP3_PORT=995
EMAIL_POP3_TIMEOUT_SECONDS=30
EMAIL_INITIAL_LOOKBACK_HOURS=48
EMAIL_INITIAL_MAX_MESSAGES=100
EMAIL_DEFAULT_RETENTION_DAYS=7
EMAIL_MIN_RETENTION_DAYS=1
EMAIL_MAX_RETENTION_DAYS=365
EMAIL_MAX_BODY_CHARS=50000
EMAIL_CREDENTIAL_KEY=replace-with-32-byte-base64-key
EMAIL_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
EMAIL_SQLSERVER_SERVER=replace-me
EMAIL_SQLSERVER_PORT=1433
EMAIL_SQLSERVER_DATABASE=AI_outlook_email
EMAIL_SQLSERVER_USER=replace-me
EMAIL_SQLSERVER_PASSWORD=replace-me
EMAIL_SQLSERVER_ENCRYPT=false
EMAIL_SQLSERVER_TRUST_SERVER_CERTIFICATE=true
